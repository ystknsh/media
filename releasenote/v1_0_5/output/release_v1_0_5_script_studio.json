      "cssStyles": [
        "h3 {margin-left: 20px; margin-top: 20px}"
      ]
    },
    "audioParams": {
      "padding": 0.3,
      "introPadding": 1,
      "closingPadding": 0.8,
      "outroPadding": 1,
      "bgmVolume": 0.2,
      "audioVolume": 1,
      "suppressSpeech": false
